{
    "epochs":20,
    "batch_size":24,
    "num_workers":4,
    "lr":1e-4,//0.00001,//1e-3,
    "early_stopping":5, // patience for early stopping. If null or <=0, no early stopping
    "weight_decay":1e-3,
    "schedule":"cos",//options: none, cosine, (not implemented yet)
    "warmup_epochs":-1,//20, //epochs to warmup
    "min_lr":0, // minimum learning rate bound for cyclic schedulers that hit 0
    "loss":"cross_entropy",
    "optimizer":"adam",
    "normalization":"standard", // Options: standard (0 mean, 1 std), min-max (min 0, max 1), none
    "augment":false,
    "metric_aggregation_strategy":["micro","macro","weighted"], // Options, micro, macro, none for per-class calculation
    "distributed":false,
    "pin_memory":true,
    "prefetch_factor":2,
    "persistent_workers":false,
    "linear_evaluation":false, // set to true to evaluate a pretrained model
    "fully_finetune":true, // set to true to finetune the whole FoMo model 
    "deconv_decoder":true,
    "multiple_transformation":false,
    "pretrained_model_path":"/network/projects/fomobench/fomov2_checkpoints/single_embedding_layer/offline/trained_vit_300.pt", //path for the checkpoint to be evaluated under the linear eval protocol
    "resume_checkpoint_path":null, // checkpoint to resume training
    "enforce_resize":224, // if not none, data will be resized in both train/evaluation to the provided value (only for webdataset setting),
    "change_finetuning_resolution":224, // If not none, the finetuning vit will have its positional embedding changed to support the new res
    "finetuning_patch_size":16, // In accordance to finetuning resolution. Ideally keep it the same as in training
    "start_epoch":0, // epoch to continue training
    "log_images":false
}