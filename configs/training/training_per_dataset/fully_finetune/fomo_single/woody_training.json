    "persistent_workers":false,
    "linear_evaluation":false, // set to true to evaluate a pretrained model
    "fully_finetune":true, // set to true to finetune the whole FoMo model 
    "deconv_decoder":true,
    "multiple_transformation":false,
    "pretrained_model_path":"/home/mila/n/nikolaos.bountos/scratch/FoMov3/checkpoints/mae/all/vit_patch_16_depth_12_heads_12/mask_ratio_0.75/single_embedding_layer/offline/trained_vit_300.pt", //path for the checkpoint to be evaluated under the linear eval protocol
