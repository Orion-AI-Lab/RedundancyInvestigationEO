{
    "epochs":400,
    "batch_size":2,
    "num_workers":2,
    "lr":1e-4,
    "weight_decay":5e-4,
    "warmup_epochs":1500, //epochs to warmup, currently in iteration!!!
    "min_lr":0, // minimum learning rate bound for cyclic schedulers that hit 0
    "momentum":0.9,
    "loss":"cross_entropy",
    "optimizer":"sgd",
    "lr_step":8000,
    "normalization":"other", // Options: standard (0 mean, 1 std), min-max (min 0, max 1), none
    "augment":true,
    "metric_aggregation_strategy":[null], // Options, micro, macro, none for per-class calculation
    "distributed":false,
    "pin_memory":true,
    "prefetch_factor":2,
    "linear_evaluation":true, // set to true to evaluate a pretrained model
    // "pretrained_model_path":"/network/projects/fomobench/checkpoints/fomonet/single_embedding/vit_79.pt",
    "pretrained_model_path":"/network/projects/fomobench/checkpoints/fomonet/multiple_embedding_layers/vit_79.pt",
    "single_embedding_layer":false,
    "deconv_decoder":true,
    // "exceptional_resize":32,
    "change_finetuning_resolution":null,
    "has_collate_fn":true, // indicates if dataloader has a collate_fn method
    "det_format":"pascal_voc", // define format for bounding boxes: pascal_voc, coco or yolo
    "resume_checkpoint_path":null, // checkpoint to resume training
    "enforce_resize":null, // if not none, data will be resized in both train/evaluation to the provided value (only for webdataset setting),
    "change_finetuning_resolution":null, // If not none, the finetuning vit will have its positional embedding changed to support the new res
    "iou_thresh": 0.1,
    "conf_thresh": 0.,
    "eval_metric":"map",
    "modality_channels": {
        "28": 0,
        "29": 1,
        "30": 2,
    },
    "dataset_modality_index":{
	"reforestree":{
            "28":0,
            "29":1,
            "30":2,
	},
    },
    "output_size":224,  //Generate embedding from FoMo
    "out_channels":32, //Generate embedding from FoMo
    "change_finetuning_resolution":224,
    "finetuning_patch_size":16
}
