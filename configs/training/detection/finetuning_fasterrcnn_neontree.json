{
    "epochs":200,
    "batch_size":10,
    "num_workers":2,
    "lr": 5e-5,
    "weight_decay":5e-4,
    "warmup_epochs":1500, //epochs to warmup, currently in iteration!!!
    "min_lr":0, // minimum learning rate bound for cyclic schedulers that hit 0
    "momentum":0.9,
    "loss":"cross_entropy",
    "optimizer":"sgd",
    "lr_step":20000,
    "normalization":"other", // Options: standard (0 mean, 1 std), min-max (min 0, max 1), none
    "augment":true,
    "metric_aggregation_strategy":[null], // Options, micro, macro, none for per-class calculation
    "distributed":false,
    "pin_memory":true,
    "prefetch_factor":2,
    "linear_evaluation":true, // set to true to evaluate a pretrained model
    "deconv_decoder":true, // transform FoMo representation with Conv Decoder
    // "pretrained_model_path":"/network/scratch/a/arthur.ouaknine/data/fomobench/backbones/vit_103.pt", //path for the checkpoint to be evaluated under the linear eval protocol
    "pretrained_model_path":"/network/projects/fomobench/checkpoints/fomonet/single_embedding/vit_79.pt", //path for the checkpoint to be evaluated under the linear eval protocol
    // "pretrained_model_path":"/network/projects/fomobench/checkpoints/fomonet/multiple_embedding_layers/vit_79.pt", //path for the checkpoint to be evaluated under the linear eval protocol
    // "checkpoint_path":"/network/projects/fomobench/checkpoints/linear_eval/detection/neontree_detection/fasterrcnn/resnet50/eager-river-86", // TO test (evaluate) models only
    "single_embedding_layer":true,
    "change_finetuning_resolution":null,
    "has_collate_fn":true, // indicates if dataloader has a collate_fn method
    "det_format":"pascal_voc", // define format for bounding boxes: pascal_voc, coco or yolo
    "resume_checkpoint_path":null, // checkpoint to resume training
    "enforce_resize":null, // if not none, data will be resized in both train/evaluation to the provided value (only for webdataset setting),
    "change_finetuning_resolution":null, // If not none, the finetuning vit will have its positional embedding changed to support the new res
    "finetuning_patch_size":null, // In accordance to finetuning resolution. Ideally keep it the same as in training
    "iou_thresh": 0.1,
    "conf_thresh": 0.,
    "eval_metric":"iou",
    "modality_channels": {
        "28": 0,
        "29": 1,
        "30": 2,
    },
    "dataset_modality_index":{
	"neontree_detection":{
            "28":0,
            "29":1,
            "30":2,
	},
    },
    "output_size":224,  //Generate embedding from FoMo
    "out_channels": 32, //3072, //Generate embedding from FoMo
    "change_finetuning_resolution":224,
    "finetuning_patch_size":16
}
