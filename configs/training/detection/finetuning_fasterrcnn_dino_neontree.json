{
    "epochs":400,
    "batch_size":16, // Currently 16 is possible
    "num_workers":2,
    "lr": 1e-4,
    "weight_decay":5e-4,
    "warmup_epochs":1500, //epochs to warmup, currently in iteration!!!
    "min_lr":0, // minimum learning rate bound for cyclic schedulers that hit 0
    "momentum":0.9,
    "loss":"cross_entropy",
    "optimizer":"sgd",
    "lr_step":30000,
    "normalization":"none", // Options: standard (0 mean, 1 std), min-max (min 0, max 1), none
    "augment":true,
    "metric_aggregation_strategy":[null], // Options, micro, macro, none for per-class calculation
    "distributed":false,
    "pin_memory":true,
    "prefetch_factor":2,
    "deconv_decoder":true,
    "linear_evaluation":false, // set to true to evaluate a pretrained model
    "pretrained_model_path":null, //path for the checkpoint to be evaluated under the linear eval protocol
    "change_finetuning_resolution":null,
    "has_collate_fn":true, // indicates if dataloader has a collate_fn method
    "det_format":"pascal_voc", // define format for bounding boxes: pascal_voc, coco or yolo
    "resume_checkpoint_path":null, // checkpoint to resume training
    "enforce_resize":null, // if not none, data will be resized in both train/evaluation to the provided value (only for webdataset setting),
    "change_finetuning_resolution":null, // If not none, the finetuning vit will have its positional embedding changed to support the new res
    "finetuning_patch_size":null, // In accordance to finetuning resolution. Ideally keep it the same as in training
    "iou_thresh": 0.1,
    "conf_thresh": 0.,
    "eval_metric":"iou",
    "modality_channels": {
        "28": 0,
        "29": 1,
        "30": 2,
    },
    "dataset_modality_index":{
	"neontree":{
            "28":0,
            "29":1,
            "30":2,
	},
    },
    "output_size":224,  // currently not used
    "out_channels":32, //Generate embedding from Dino
    "encoder_in_features":771,
    "change_finetuning_resolution":224, // currently not used
    "finetuning_patch_size":16 // currently not used
}
